{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 330,
  "background": "white",
  "data": {
    "url": "data/alcohol_drinking_status.csv"
  },
  "params": [
    {
      "name": "selected_year",
      "value": 2022,
      "bind": {
        "input": "range",
        "min": 2001,
        "max": 2022,
        "step": 3,
        "name": "Select year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year == selected_year"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 4,
    "cornerRadiusTopRight": 4
  },
  "encoding": {
    "x": {
      "field": "status",
      "type": "nominal",
      "title": "Drinking status",
      "sort": "-y",
      "axis": {
        "labelAngle": -25,
        "labelFontSize": 12,
        "titleFontSize": 14
      }
    },
    "y": {
      "field": "percentage",
      "type": "quantitative",
      "title": "Percent",
      "scale": {
        "domain": [0, 50]
      },
      "axis": {
        "labelFontSize": 12,
        "titleFontSize": 14,
        "grid": true,
        "gridColor": "#e5e5e5"
      }
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "title": "Drinking status",
      "scale": {
        "domain": [
          "Daily",
          "Weekly",
          "Monthly",
          "Less often than monthly",
          "Ex-drinker",
          "Never a full glass of alcohol"
        ],
        "range": [
          "#D1495B",
          "#00798C",
          "#EDAE49",
          "#30638E",
          "#6A4C93",
          "#588157"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "status",
        "type": "nominal",
        "title": "Drinking status"
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Percent",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 330,
  "data": {
    "url": "data/alcohol_drinking_status.csv"
  },
  "params": [
    {
      "name": "status_select",
      "select": {
        "type": "point",
        "fields": ["status"],
        "on": "click",
        "clear": "dblclick"
      },
       "bind": "legend"
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 70
    },
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "tickSize": 0,
        "domainColor": "#555555"
      }
    },
    "y": {
      "field": "percentage",
      "type": "quantitative",
      "title": "Percent",
      "scale": {
        "domain": [0, 50]
      },
      "axis": {
        "labelFontSize": 12,
        "titleFontSize": 14,
        "grid": true,
        "gridColor": "#e5e5e5",
        "domainColor": "#555555"
      }
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "title": "Drinking status",
      "scale": {
        "domain": [
          "Daily",
          "Weekly",
          "Monthly",
          "Less often than monthly",
          "Ex-drinker",
          "Never a full glass of alcohol"
        ],
        "range": [
          "#D1495B",
          "#00798C",
          "#EDAE49",
          "#30638E",
          "#6A4C93",
          "#588157"
        ]
      },
      "legend": {
        "orient": "bottom",
        "columns": 3,
        "labelFontSize": 12,
        "titleFontSize": 14,
        "symbolType": "square",
        "symbolSize": 160
      }
    },
    "opacity": {
      "condition": {
        "param": "status_select",
        "value": 1
      },
      "value": 0.18
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "status",
        "type": "nominal",
        "title": "Drinking status"
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Percent",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 230,
  "background": "white",
  "data": {
    "url": "data/per_capita_alcohol_consumption_2001_2022.csv"
  },
  "mark": {
    "type": "line",
    "point": true,
    "strokeWidth": 3,
    "color": "#12355B"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "format": "d",
        "tickMinStep": 1,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "per_capita_litres",
      "type": "quantitative",
      "title": "Litres of pure alcohol per person",
      "scale": {
        "zero": false
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "per_capita_litres",
        "type": "quantitative",
        "title": "Litres per person",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#e6e6e6"
    }
  }
}